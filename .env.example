APP_NAME=Green Leaf API-Doc
APP_VERSION=1.0.0
PORT=8000

# Database Configuration (per environment)
# Development
DEV_DB_NAME=ecom-db-dev
DEV_DB_USER=root
DEV_DB_PASSWORD=your_password_here
DEV_DB_HOST=localhost
DEV_DB_PORT=3306

# Test
TEST_DB_NAME=ecom-db-test
TEST_DB_USER=root
TEST_DB_PASSWORD=your_password_here
TEST_DB_HOST=localhost
TEST_DB_PORT=3306

# Production
PROD_DB_NAME=ecom-db-prod
PROD_DB_USER=root
PROD_DB_PASSWORD=your_password_here
PROD_DB_HOST=localhost
PROD_DB_PORT=3306

# API Configuration
SWAGGER_URL=/api-docs
BASE_URL=http://localhost:8000

# JWT Secret (generate a secure random string)
JWT_SECRET=your_secret_key_here

# Environment
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX=100  # Max requests per window

# CLOUDFLARE R2 SETTINGS (Required for image uploads)
CLOUDFLARE_BUCKET_NAME=your-bucket-name
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_PUBLIC_BASE_URL=https://your-public-domain.com

# EMAIL CONFIGURATION
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
# PAYHERE PAYMENT GATEWAY (Sri Lankan payment gateway)
PAYHERE_MERCHANT_ID=your-merchant-id
PAYHERE_MERCHANT_SECRET=your-merchant-secret
PAYHERE_MODE=sandbox  # sandbox or live
PAYHERE_API_URL=https://sandbox.payhere.lk
PAYHERE_NOTIFY_URL=http://localhost:8000/api/payments/payhere/notify
PAYHERE_RETURN_URL=http://localhost:3000/checkout/payment-complete
PAYHERE_CANCEL_URL=http://localhost:3000/checkout/payment-cancelled
PAYHERE_CURRENCY=LKR